<Window x:Class="GHubXBOXProfileFixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G HUB · Xbox Profile Fixer"
        Width="1180" Height="800" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="Workspace">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0">
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource PaleGreenBrush}" Margin="0,0,12,0">
                    <TextBlock Text="G" Foreground="{StaticResource GreenBrush}" FontFamily="Segoe UI Semibold"
                               FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="G HUB / Xbox Profile Fixer" FontFamily="Segoe UI Semibold" FontSize="18" VerticalAlignment="Center" />
                <Border Background="#252F3A" CornerRadius="5" Padding="9,4" Margin="12,0,0,0">
                    <TextBlock Text="COMMUNITY TOOL" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="16,32">
                    <TextBlock Text="SETUP" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="16,0,0,20" />
                    <Button x:Name="Step1Nav" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Padding="16,15" Margin="0,0,0,8" Click="Step1Nav_Click">
                        <TextBlock x:Name="Step1NavText" Text="1     G Hub database" FontFamily="Segoe UI Semibold" FontSize="14" />
                    </Button>
                    <Button x:Name="Step2Nav" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Padding="16,15" Margin="0,0,0,8" Click="Step2Nav_Click">
                        <TextBlock x:Name="Step2NavText" Text="2     XBOX games" FontFamily="Segoe UI Semibold" FontSize="14" />
                    </Button>
                    <Button x:Name="Step3Nav" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Padding="16,15" Click="Step3Nav_Click">
                        <TextBlock x:Name="Step3NavText" Text="3     Add profiles" FontFamily="Segoe UI Semibold" FontSize="14" />
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="44,30,44,28">
                <Grid x:Name="DatabasePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="Connect G HUB" FontFamily="Segoe UI Semibold" FontSize="32" />
                        <TextBlock Text="Choose your settings file to find games missing from G HUB." TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="G HUB settings file" FontFamily="Segoe UI Semibold" FontSize="16" />
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DatabasePathBox" TextChanged="DatabasePathChanged" AutomationProperties.Name="G HUB database path" Height="40" FontSize="14" VerticalContentAlignment="Center"
                                         Padding="11,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseDatabase_Click" />
                            </Grid>
                            <TextBlock x:Name="DatabaseStatusText" Grid.Row="2" Text="Select your settings.db"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" FontSize="13" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="Apply profiles with an automatic dated backup, or export a separate copy." TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="4,18,0,0" />
                    <Button Grid.Row="4" Content="Continue" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            Width="150" Click="DatabaseContinue_Click" />
                </Grid>

                <Grid x:Name="GamesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Your game library" FontFamily="Segoe UI Semibold" FontSize="32" />
                        <TextBlock Text="Choose the games that need a profile. Check suggested executables before exporting." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="settings.db" FontFamily="Segoe UI Semibold" FontSize="15" />
                                <TextBlock x:Name="DatabasePathSummary" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="✓  Ready" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="16,0" />
                            <Button Grid.Column="2" Content="Change" Style="{StaticResource SecondaryButton}" Click="ChangeDatabase_Click" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Scan library" Style="{StaticResource SecondaryButton}" Click="ScanAgain_Click" />
                        <Button Grid.Column="1" Content="Add folder" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="AddFolder_Click" />
                        <Button Grid.Column="2" Content="Add .exe" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="AddExecutable_Click" />
                        <Button Grid.Column="3" Content="Select / clear all" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="SelectAll_Click" />
                        <TextBlock x:Name="ScanSummaryText" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,10,0,0" Text="Not scanned yet" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Grid>

                    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                        <StackPanel x:Name="EmptyState" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <TextBlock Text="Find your installed games" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Scan your library, choose a folder or add a game executable." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="GamesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"
                                                          Click="GameCheckBox_Click" AutomationProperties.Name="{Binding Name}" />
                                                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="7" Background="#252F3A" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="34" Height="34" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="2" Margin="12,0,18,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="15" />
                                                    <TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePath}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="13" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding Detection}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SelectedCountText" Text="0 games selected" FontFamily="Segoe UI Semibold" FontSize="14" VerticalAlignment="Center" />

                        <Button x:Name="GamesContinueButton" Grid.Column="2" Content="Review selection" Style="{StaticResource PrimaryButton}" Width="180" Click="GamesContinue_Click" />
                    </Grid>
                </Grid>

                <Grid x:Name="CreatePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="Add profiles to G HUB" FontFamily="Segoe UI Semibold" FontSize="32" />
                        <TextBlock Text="Update your selected settings.db automatically, or save a separate copy for manual installation." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" MaxHeight="300" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                            <TextBlock Text="SELECTED PROFILES" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,14" />
                            <TextBlock x:Name="CreateCountText" FontFamily="Segoe UI Semibold" FontSize="18" />
                            <TextBlock x:Name="CreateNamesText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="CreateSourceText" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap" />
                        </StackPanel></ScrollViewer>
                    </Border>
                    <TextBlock Grid.Row="2" Text="1. Keep G HUB closed.&#10;2. Click Back up &amp; update G HUB. We save a dated backup, then install your profiles.&#10;3. Open G HUB when the update is complete." TextWrapping="Wrap"
                               Foreground="{StaticResource GreenBrush}" Margin="4,18,0,0" />
                    <StackPanel Grid.Row="4" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Back to games" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Width="135" Click="BackToGames_Click" />
                            <Button Grid.Column="1" Content="Back up &amp; update G HUB" Style="{StaticResource PrimaryButton}" Width="260" Click="ApplyDatabase_Click"
                                    ToolTip="Creates a dated backup and replaces the selected settings.db. No manual copying is needed." />
                        </Grid>
                        <TextBlock Text="Updates settings.db automatically. No copying or renaming needed." Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Right" Margin="0,8,0,16" />
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Optional: save a file to install manually. Your current settings stay unchanged."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0" />
                                <Button Grid.Column="1" Content="Save a separate copy…" Style="{StaticResource SecondaryButton}" Width="220" Click="CreateDatabase_Click"
                                        ToolTip="Exports a separate .db file. You must install it yourself to use the profiles." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid x:Name="CompletionPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="Your profiles are installed" FontFamily="Segoe UI Semibold" FontSize="30" TextWrapping="Wrap" />
                        <TextBlock x:Name="AppliedCountText" Foreground="{StaticResource GreenBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Your backup is safe" FontFamily="Segoe UI Semibold" FontSize="18" />
                                    <TextBlock x:Name="BackupSavedText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <TextBlock Text="To undo this update: close G HUB, keep a copy of its current settings.db, then copy this backup into the same folder and rename the copy settings.db."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                    <Button Content="Show backup in folder" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ShowBackup_Click" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="What to do next" FontFamily="Segoe UI Semibold" FontSize="20" Margin="0,24,0,12" />
                            <TextBlock Text="1. Open G HUB using the button below.&#10;2. Find your games in G HUB and customise their profiles.&#10;3. Launch a game and check that G HUB switches to its profile."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Open G HUB" Style="{StaticResource PrimaryButton}" Width="210" HorizontalAlignment="Right" Margin="0,20,0,0" Click="OpenGHub_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
